# ── Required ────────────────────────────────────────────────────────────────
# The server refuses to start without these.
DATABASE_URL="mysql://user:password@localhost:3306/workouttracker"
JWT_SECRET="generate-with: openssl rand -hex 32"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug
JSON_BODY_LIMIT=100kb

# Comma separated list of allowed browser origins. REQUIRED in production;
# leaving it empty outside production allows any origin.
CORS_ORIGINS=

# ── Tokens ──────────────────────────────────────────────────────────────────
# Access tokens are short lived because they cannot be revoked; the refresh
# token is the one that can be.
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30

# ── Password reset ──────────────────────────────────────────────────────────
OTP_TTL_MINUTES=5
RESET_TOKEN_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── SMTP ────────────────────────────────────────────────────────────────────
# REQUIRED in production. Without it, outside production, reset codes are
# written to the log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Workout Tracker <no-reply@workouttracker.app>"
