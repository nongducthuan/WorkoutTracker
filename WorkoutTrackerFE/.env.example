# PULSE Mobile — Environment Variables (Example / Template)
# Sao chép file này thành .env và điền giá trị thực.

# API Base URL
# - Để rỗng hoặc "mock" → dùng mock data nội bộ (không cần backend chạy)
# - Android emulator   → http://10.0.2.2:<PORT>/api
# - iOS simulator      → http://localhost:<PORT>/api
# - Thiết bị vật lý    → http://<IP_LAN_CỦA_MÁY>:<PORT>/api
# - Production         → https://api.yourapp.com/api
EXPO_PUBLIC_API_BASE_URL=
